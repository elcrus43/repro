{
    "rewrites": [
        {
            "source": "/api/ksm-lots",
            "destination": "/api/developer-lots?provider=ksm"
        },
        {
            "source": "/api/kssk-lots",
            "destination": "/api/developer-lots?provider=kssk"
        },
        {
            "source": "/api/kino-lots",
            "destination": "/api/developer-lots?provider=kino"
        },
        {
            "source": "/api/avitek-lots",
            "destination": "/api/developer-lots?provider=avitek"
        },
        {
            "source": "/api/altai-lots",
            "destination": "/api/developer-lots?provider=altai"
        },
        {
            "source": "/api/stroysoyuz-lots",
            "destination": "/api/developer-lots?provider=stroysoyuz"
        },
        {
            "source": "/api/profstroy-lots",
            "destination": "/api/developer-lots?provider=profstroy"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron-lots?provider=kssk",
            "schedule": "0 5 * * *"
        },
        {
            "path": "/api/tiktok-report",
            "schedule": "0 4 * * *"
        }
    ]
}
